APP_NAME="FastAPI Boilerplate"
# development | test | staging | production
# staging/production refuse to boot with an unsafe config (see app/core/config.py)
APP_ENV=development
APP_DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me

# HTTP (comma-separated)
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*

# Database (docker compose overrides DB_HOST/DB_PORT with the db service)
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=user
DB_PASSWORD=password
# "require" or "verify-full" in production
DB_SSLMODE=prefer
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
JWT_ISSUER=fastapi-boilerplate
JWT_AUDIENCE=fastapi-boilerplate-api

# Rate limiting (per client IP). Use redis://host:6379 when running several workers.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_REFRESH=30/minute

# Logging: LOG_FORMAT=json (default, one JSON object per line) or console (readable)
LOG_LEVEL=INFO
LOG_FORMAT=console

# Container / gunicorn (used by the Docker image, see README "Deployment")
# WEB_CONCURRENCY: workers per container; each opens up to DB_POOL_SIZE + DB_MAX_OVERFLOW DB connections
WEB_CONCURRENCY=2
# Proxy addresses allowed to set X-Forwarded-For/-Proto. Behind a load balancer put its
# address or network here (not "*" unless the app is only reachable through it).
FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Apply `alembic upgrade head` at container start. false when running several replicas:
# run the migration once as a separate job instead.
RUN_MIGRATIONS=true
# docker compose only: host port of the API (default 8000) and of the dev database
# API_PORT=8000
# DB_PUBLISH_PORT=5432

# Prometheus: GET /metrics (route-template labels). Keep it off the public internet;
# METRICS_TOKEN additionally requires "Authorization: Bearer <token>".
PROMETHEUS_ENABLED=false
METRICS_TOKEN=

# Sentry: set a DSN to report unhandled exceptions (request bodies are never sent)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
