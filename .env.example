APP_NAME="FastAPI Boilerplate"
# development | test | staging | production
# staging/production refuse to boot with an unsafe config (see app/core/config.py)
APP_ENV=development
APP_DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me

# HTTP (comma-separated)
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*

# Database
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=user
DB_PASSWORD=password
# "require" or "verify-full" in production
DB_SSLMODE=prefer
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
JWT_ISSUER=fastapi-boilerplate
JWT_AUDIENCE=fastapi-boilerplate-api

# Rate limiting (per client IP). Use redis://host:6379 when running several workers.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_REFRESH=30/minute

# Logging: LOG_FORMAT=json (default, one JSON object per line) or console (readable)
LOG_LEVEL=INFO
LOG_FORMAT=console

# Prometheus: GET /metrics (route-template labels). Keep it off the public internet;
# METRICS_TOKEN additionally requires "Authorization: Bearer <token>".
PROMETHEUS_ENABLED=false
METRICS_TOKEN=
